# Copy to srcs/.env and replace "login" with your 42 login.
# No passwords here: they live in ../secrets/ (generated by `make`).
LOGIN=login
DOMAIN_NAME=login.42.fr
# Public IP of the VM; `make hosts` on your PC maps DOMAIN_NAME to it (empty = 127.0.0.1)
VM_IP=

# MYSQL SETUP
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser

# WORDPRESS SETUP (admin username must not contain "admin")
WP_TITLE=Inception
WP_ADMIN_USER=login_boss
WP_ADMIN_EMAIL=login_boss@student.42.fr
WP_USER=login_writer
WP_USER_EMAIL=login_writer@student.42.fr
